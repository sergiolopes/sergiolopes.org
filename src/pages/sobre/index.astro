---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteBase, siteUrl } from '../../lib/site';
---
<BaseLayout title="Sobre" description="Artigos, palestras, livros, podcasts e perfis de Sérgio Lopes." section="sobre">
  <div class="page-shell about">
    <header class="about__hero">
      <div>
        <h1>Sérgio Lopes</h1>
        <p>Escrevo sobre desenvolvimento web, mobile e tecnologia.</p>
      </div>
      <img src={siteBase + '/images/sergio-lopes.jpg'} alt="Sérgio Lopes" width="400" height="400" />
    </header>
    <div class="about__body">
      <div class="prose">
        <p>Aqui estão meus artigos, palestras, livros e participações em podcasts.</p>
        <p>O site reúne publicações próprias e cópias de textos que foram publicados originalmente em outros lugares.</p>
      </div>
      <nav class="about__links" aria-label="Conteúdos e perfis">
        <a href={siteUrl('artigos')}><strong>Artigos</strong><small>textos publicados</small></a>
        <a href={siteUrl('palestras')}><strong>Palestras</strong><small>slides e apresentações</small></a>
        <a href={siteUrl('livros')}><strong>Livros</strong><small>autoria e colaboração</small></a>
        <a href={siteUrl('podcasts')}><strong>Podcasts</strong><small>participações</small></a>
        <a href="https://x.com/sergio_caelum" rel="me external noopener"><strong>X</strong><small>@sergio_caelum ↗</small></a>
        <a href="https://www.linkedin.com/in/sergiolopesjr/" rel="me external noopener"><strong>LinkedIn</strong><small>perfil profissional ↗</small></a>
      </nav>
    </div>
  </div>
</BaseLayout>

<style>
  .about__hero { align-items: end; border-bottom: 1px solid var(--color-line); display: grid; gap: 3rem; grid-template-columns: minmax(0, 1fr) 10rem; padding-bottom: 3rem; }
  .about__hero h1 { font-size: clamp(3rem, 7vw, 6.8rem); letter-spacing: -.075em; line-height: .9; margin: 0; }
  .about__hero p { color: var(--color-muted); font-size: 1.15rem; margin: 1.3rem 0 0; max-width: 28rem; }
  .about__hero img { aspect-ratio: 1; border: 2px solid var(--color-accent); display: block; object-fit: cover; width: 100%; }
  .about__body { display: grid; gap: 6rem; grid-template-columns: minmax(0, 1fr) minmax(19rem, 1fr); padding-top: 3.5rem; }
  .about__links { border-top: 1px solid var(--color-line); display: grid; grid-template-columns: repeat(2, 1fr); }
  .about__links a { border-bottom: 1px solid var(--color-line); display: grid; gap: .15rem; padding: .9rem 0; text-decoration: none; }
  .about__links a:nth-child(odd) { padding-right: 1.5rem; }
  .about__links strong { font-size: 1rem; font-weight: 600; }
  .about__links small { color: var(--color-muted); font-size: .82rem; }
  .about__links a:hover strong { color: var(--color-accent-strong); }
  @media (max-width: 52rem) { .about__body { gap: 3rem; grid-template-columns: 1fr; } }
  @media (max-width: 45rem) { .about__hero { grid-template-columns: minmax(0, 1fr) 8rem; } .about__hero h1 { font-size: 3.1rem; } }
  @media (max-width: 32rem) { .about__hero { display: block; } .about__hero img { margin-top: 2rem; max-width: 9rem; } .about__links { display: block; } .about__links a:nth-child(odd) { padding-right: 0; } }
</style>
