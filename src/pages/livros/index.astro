---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteUrl } from '../../lib/site';

const books = [
  {
    type: 'Autor',
    title: 'A Web Mobile',
    description: 'Um livro sobre interfaces para diferentes dispositivos, design responsivo e desenvolvimento para a web móvel.',
    href: siteUrl('livro-web-mobile'),
    label: 'Ver arquivo',
  },
  {
    type: 'Autor',
    title: 'Aplicações mobile híbridas com Cordova e PhoneGap',
    description: 'Um guia para criar aplicações móveis híbridas com tecnologias web.',
    href: 'https://www.casadocodigo.com.br/products/livro-cordova-phonegap',
    label: 'Ver na Casa do Código',
  },
  {
    type: 'Editor',
    title: 'Coletânea Front-end',
    description: 'Coletânea de textos sobre desenvolvimento front-end.',
    href: 'https://casadocodigo.refersion.com/l/f49.5558',
    label: 'Ver na Casa do Código',
  },
  {
    type: 'Coautor',
    title: 'Introdução à arquitetura e design Java',
    description: 'Livro sobre arquitetura e design de aplicações Java.',
    href: 'http://www.arquiteturajava.com.br/',
    label: 'Ver site do projeto',
  },
];
---
<BaseLayout title="Livros" description="Livros escritos, editados ou coescritos por Sérgio Lopes." section="livros">
  <div class="page-shell">
    <header class="section-head">
      <h1>Livros</h1>
      <p>Livros que escrevi, editei ou coescrevi.</p>
    </header>
    <div class="book-list">
      {books.map((book, index) => (
        <article class="book-row">
          <div>
            <p class="book-row__type">{book.type}</p>
            <h2><a href={book.href}>{book.title}</a></h2>
            <p>{book.description}</p>
          </div>
          <a class="link-arrow" href={book.href}>{book.label}</a>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .book-list { border-top: 1px solid var(--color-line); }
  .book-row { align-items: start; border-bottom: 1px solid var(--color-line); display: grid; gap: 1.5rem; grid-template-columns: 1fr 12rem; padding: 2.1rem 0; }
  .book-row__type { color: var(--color-muted); font-size: .78rem; margin: 0 0 .65rem; }
  .book-row h2 { font-size: clamp(1.7rem, 3vw, 2.8rem); letter-spacing: -.04em; line-height: 1.04; margin: 0; }
  .book-row h2 a { text-decoration: none; }
  .book-row p:last-child { color: var(--color-muted); line-height: 1.7; margin: .9rem 0 0; max-width: 40rem; }
  .book-row > .link-arrow { align-self: center; }
  @media (max-width: 45rem) { .book-row { grid-template-columns: 1fr; gap: .8rem; } .book-row > .link-arrow { grid-column: 1; } }
</style>
