---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveCard from '../../components/ArchiveCard.astro';
import { entriesForYear, podcasts, years } from '../../lib/archive';
import { siteUrl, sortedEntries } from '../../lib/site';

const listed = sortedEntries(podcasts);
const podcastYears = years.filter((year) => entriesForYear(year, 'podcast').length);
---
<BaseLayout title="Podcasts" description="Participações de Sérgio Lopes em podcasts." section="podcasts">
  <div class="page-shell">
    <header class="section-head">
      <h1>Podcasts</h1>
      <p>Conversas de que participei em Hipsters Ponto Tech, IA Sob Controle e outros programas.</p>
    </header>
    <nav class="year-nav" aria-label="Índice por ano">
      <a class="active" href={siteUrl('podcasts')}>Todos</a>
      {podcastYears.map((year) => <a href={siteUrl('podcasts/ano/' + year)}>{year}</a>)}
    </nav>
    {listed.length ? (
      <div class="archive-grid">{listed.map((entry, index) => <ArchiveCard entry={entry} index={index + 1} />)}</div>
    ) : (
      <p class="empty-state">Nenhuma participação encontrada.</p>
    )}
  </div>
</BaseLayout>
