---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArchiveCard from '../../../components/ArchiveCard.astro';
import { entriesForYear, years } from '../../../lib/archive';
import { siteUrl, sortedEntries } from '../../../lib/site';

export function getStaticPaths() {
  return years
    .filter((year) => entriesForYear(year, 'podcast').length)
    .map((year) => ({ params: { year: String(year) }, props: { year } }));
}

const year = Number(Astro.params.year);
const listed = sortedEntries(entriesForYear(year, 'podcast'));
---
<BaseLayout title={'Podcasts de ' + year} description={'Índice das participações em podcasts de Sérgio Lopes em ' + year + '.'} section="podcasts">
  <div class="page-shell">
    <header class="section-head">
      <div><p class="section-kicker">índice anual · podcasts</p><h1>{year}</h1></div>
      <p>{listed.length} {listed.length === 1 ? 'registro encontrado' : 'registros encontrados'} neste ano.</p>
    </header>
    <nav class="year-nav" aria-label="Navegar entre anos">
      <a href={siteUrl('podcasts')}>todos</a>
      {years.filter((item) => entriesForYear(item, 'podcast').length).map((item) => <a class:list={{ active: item === year }} href={siteUrl('podcasts/ano/' + item)}>{item}</a>)}
    </nav>
    <div class="archive-grid">{listed.map((entry, index) => <ArchiveCard entry={entry} index={index + 1} />)}</div>
  </div>
</BaseLayout>

