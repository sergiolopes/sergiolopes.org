---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import { entries, podcasts, talks } from '../lib/archive';
import { articleEntries, siteBase, siteUrl, sortedEntries } from '../lib/site';

const latest = sortedEntries(entries.filter((entry) => entry.date)).slice(0, 6);
const articleRecords = articleEntries(entries);
---
<BaseLayout title="Sérgio Lopes" description="Artigos, palestras, livros e podcasts de Sérgio Lopes.">
  <div class="home">
    <section class="home-intro page-shell">
      <div class="home-intro__copy">
        <h1>Sérgio Lopes</h1>
        <p class="home-intro__line">Artigos, palestras, livros e podcasts.</p>
        <div class="home-intro__actions">
          <a class="button-link button-link--quiet" href={siteUrl('artigos')}>Ver artigos</a>
          <a class="link-arrow" href={siteUrl('sobre')}>Sobre Sérgio</a>
        </div>
      </div>
      <figure class="home-portrait">
        <img src={siteBase + '/images/sergio-lopes.jpg'} alt="Sérgio Lopes" width="400" height="400" />
        <figcaption>São Paulo, Brasil</figcaption>
      </figure>
    </section>

    <section class="home-latest page-shell" aria-labelledby="latest-title">
      <header class="section-head">
        <h2 id="latest-title">Publicações recentes</h2>
        <a class="link-arrow" href={siteUrl('arquivo')}>Ver todo o conteúdo</a>
      </header>
      <div class="archive-grid">
        {latest.map((entry, index) => <ArchiveCard entry={entry} index={index + 1} />)}
      </div>
    </section>

    <section class="home-index page-shell" aria-labelledby="content-title">
      <header class="section-head">
        <h2 id="content-title">Navegue por tipo</h2>
      </header>
      <nav class="home-index__links" aria-label="Conteúdo por tipo">
        <a href={siteUrl('artigos')}><strong>Artigos</strong><span>{articleRecords.length} textos</span></a>
        <a href={siteUrl('podcasts')}><strong>Podcasts</strong><span>{podcasts.length} participações</span></a>
        <a href={siteUrl('palestras')}><strong>Palestras</strong><span>{talks.length} apresentações</span></a>
        <a href={siteUrl('livros')}><strong>Livros</strong><span>autoria e colaboração</span></a>
      </nav>
    </section>
  </div>
</BaseLayout>

<style>
  .home-intro { align-items: center; display: grid; gap: 3rem; grid-template-columns: minmax(0, 1fr) 7rem; padding-bottom: 3.2rem; padding-top: 4rem; }
  .home-intro h1 { font-size: clamp(2.8rem, 5vw, 4.8rem); letter-spacing: -.06em; line-height: 1; margin: 0; }
  .home-intro__line { font-size: clamp(1.15rem, 2vw, 1.4rem); letter-spacing: -.025em; line-height: 1.25; margin: 1rem 0 0; max-width: 35rem; }
  .home-intro__actions { align-items: center; display: flex; flex-wrap: wrap; gap: 1.15rem; margin-top: 1.5rem; }
  .home-portrait { margin: 0; max-width: 7rem; }
  .home-portrait img { aspect-ratio: 1; border: 1px solid var(--color-line); display: block; height: auto; object-fit: cover; width: 100%; }
  .home-portrait figcaption { color: var(--color-muted); font-size: .75rem; margin-top: .65rem; }
  .home-latest { padding-bottom: 3.5rem; padding-top: 1rem; }
  .home-index { border-top: 1px solid var(--color-line); padding-bottom: 5rem; padding-top: 3rem; }
  .home-index__links { border-top: 1px solid var(--color-line); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .home-index__links a { align-items: baseline; border-bottom: 1px solid var(--color-line); display: flex; gap: 1rem; justify-content: space-between; padding: 1rem 0; text-decoration: none; }
  .home-index__links a:nth-child(odd) { padding-right: 2rem; }
  .home-index__links strong { font-size: 1.08rem; font-weight: 600; }
  .home-index__links span { color: var(--color-muted); font-size: .84rem; }
  .home-index__links a:hover strong { color: var(--color-accent-strong); }
  @media (max-width: 48rem) {
    .home-intro { gap: 2rem; grid-template-columns: minmax(0, 1fr) 6rem; padding-bottom: 2.8rem; padding-top: 3.4rem; }
    .home-intro h1 { font-size: clamp(2.6rem, 11vw, 4rem); }
    .home-portrait { max-width: 6rem; }
  }
  @media (max-width: 32rem) {
    .home-intro { display: block; min-height: 0; }
    .home-portrait { margin-top: 2.5rem; }
    .home-index__links { display: block; }
    .home-index__links a:nth-child(odd) { padding-right: 0; }
  }
</style>
