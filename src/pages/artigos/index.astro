---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveCard from '../../components/ArchiveCard.astro';
import { entries, entriesForYear, years } from '../../lib/archive';
import { articleEntries, siteUrl, sortedEntries } from '../../lib/site';

const listed = sortedEntries(articleEntries(entries));
const articleYears = years.filter((year) => articleEntries(entriesForYear(year)).length);
---
<BaseLayout title="Artigos" description="Artigos publicados por Sérgio Lopes." section="artigos">
  <div class="page-shell">
    <header class="section-head">
      <h1>Artigos</h1>
      <p>Textos publicados ao longo dos anos, incluindo cópias preservadas de publicações externas.</p>
      <p><a href={siteUrl('artigos/cultural')}>Blog Cultural (2005–2006)</a></p>
    </header>
    <nav class="year-nav" aria-label="Índice por ano">
      <a class="active" href={siteUrl('artigos')}>Todos</a>
      {articleYears.map((year) => <a href={siteUrl('artigos/ano/' + year)}>{year}</a>)}
    </nav>
    {listed.length ? (
      <div class="archive-grid">{listed.map((entry, index) => <ArchiveCard entry={entry} index={index + 1} />)}</div>
    ) : (
      <p class="empty-state">Nenhum artigo encontrado.</p>
    )}
  </div>
</BaseLayout>
