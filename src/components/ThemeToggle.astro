---
const label = 'Alternar tema';
---
<button class="theme-toggle" type="button" data-theme-toggle aria-label={label} aria-pressed="false">
  <span class="theme-toggle__icon" aria-hidden="true">
    <svg class="theme-toggle__moon" viewBox="0 0 16 16" aria-hidden="true"><path d="M11.9 10.9A5.3 5.3 0 0 1 5.1 4.1a5.7 5.7 0 1 0 6.8 6.8Z" /></svg>
    <svg class="theme-toggle__sun" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="3" /><path d="M8 1.2v1.4M8 13.4v1.4M1.2 8h1.4M13.4 8h1.4M3.2 3.2l1 1M11.8 11.8l1 1M12.8 3.2l-1 1M4.2 11.8l-1 1" /></svg>
  </span>
  <span class="theme-toggle__label">Tema</span>
</button>

<script is:inline>
  const toggle = document.querySelector('[data-theme-toggle]');
  const root = document.documentElement;
  const getTheme = () => root.dataset.theme || 'dark';
  const setTheme = (theme) => {
    root.dataset.theme = theme;
    toggle?.setAttribute('aria-pressed', String(theme === 'light'));
    toggle?.setAttribute('data-theme', theme);
  };
  try {
    setTheme(localStorage.getItem('sergiolopes-theme') || 'dark');
  } catch {
    setTheme('dark');
  }
  toggle?.addEventListener('click', () => {
    const next = getTheme() === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('sergiolopes-theme', next); } catch {}
    setTheme(next);
  });
</script>
